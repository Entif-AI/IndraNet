{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:0.5:clock-binding",
  "type": "object",
  "properties": {
    "sourceClock": {
      "type": "string",
      "minLength": 1
    },
    "targetClock": {
      "const": "UTC"
    },
    "bindingEvidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "offsetSeconds": {
      "type": "string",
      "pattern": "^-?(?:[0-9]+)(?:\\.[0-9]+)?$"
    },
    "uncertaintySeconds": {
      "type": "string",
      "pattern": "^-?(?:[0-9]+)(?:\\.[0-9]+)?$"
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "declared",
        "measured",
        "simulated"
      ]
    }
  },
  "required": [
    "sourceClock",
    "targetClock",
    "bindingEvidence",
    "offsetSeconds",
    "uncertaintySeconds",
    "validFrom",
    "validUntil",
    "status"
  ],
  "additionalProperties": false
}
