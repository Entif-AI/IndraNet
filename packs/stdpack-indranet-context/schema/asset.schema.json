{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:schema:asset:0.5.0",
  "title": "IndraNet candidate asset",
  "$comment": "Candidate v0.5.0; Rosetta Core semantics retained; no assigned ROCK identifier. Source-of-truth: pack.json.",
  "type": "object",
  "properties": {
    "assetId": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "geometry": {
      "type": "object",
      "properties": {
        "primitive": {
          "type": "string",
          "minLength": 1
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
          },
          "minItems": 3
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "primitive",
        "dimensions",
        "unit"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "assetId",
    "mediaType",
    "geometry",
    "status"
  ],
  "additionalProperties": false
}
