{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:schema:frame-transform:0.5.0",
  "title": "IndraNet candidate frame transform",
  "$comment": "Candidate v0.5.0; Rosetta Core semantics retained; no assigned ROCK identifier. Source-of-truth: pack.json.",
  "type": "object",
  "properties": {
    "child": {
      "type": "string",
      "minLength": 1
    },
    "parent": {
      "type": "string",
      "minLength": 1
    },
    "matrix": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "string",
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        }
      }
    },
    "validFrom": {
      "type": "string",
      "format": "date-time"
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceCid": {
      "type": "string",
      "pattern": "^cidv1-sha256-[a-f0-9]{64}$"
    },
    "unit": {
      "enum": [
        "m"
      ]
    },
    "rotationConvention": {
      "const": "right-handed-active-column-vector"
    }
  },
  "required": [
    "child",
    "parent",
    "matrix",
    "validFrom",
    "validUntil",
    "evidenceCid",
    "unit",
    "rotationConvention"
  ],
  "additionalProperties": false
}
