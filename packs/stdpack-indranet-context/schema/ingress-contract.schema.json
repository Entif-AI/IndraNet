{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:schema:ingress-contract:0.5.0",
  "title": "IndraNet candidate ingress contract",
  "$comment": "Candidate v0.5.0; Rosetta Core semantics retained; no assigned ROCK identifier. Source-of-truth: pack.json.",
  "type": "object",
  "properties": {
    "adapterId": {
      "type": "string",
      "minLength": 1
    },
    "standard": {
      "type": "string",
      "minLength": 1
    },
    "nativeVersion": {
      "type": "string",
      "minLength": 1
    },
    "timeBinding": {
      "type": "string",
      "minLength": 1
    },
    "frameBinding": {
      "type": "string",
      "minLength": 1
    },
    "quantityConvention": {
      "type": "string",
      "minLength": 1
    },
    "identityScope": {
      "type": "string",
      "minLength": 1
    },
    "unsupportedSemantics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "runtimeStatus": {
      "enum": [
        "reference-mapping",
        "simulated-integration",
        "live-verified"
      ]
    }
  },
  "required": [
    "adapterId",
    "standard",
    "nativeVersion",
    "timeBinding",
    "frameBinding",
    "quantityConvention",
    "identityScope",
    "unsupportedSemantics",
    "runtimeStatus"
  ],
  "additionalProperties": false
}
