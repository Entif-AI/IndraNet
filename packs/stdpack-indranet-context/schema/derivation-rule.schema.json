{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:schema:derivation-rule:0.5.0",
  "title": "IndraNet candidate derivation rule",
  "$comment": "Candidate v0.5.0; Rosetta Core semantics retained; no assigned ROCK identifier. Source-of-truth: pack.json.",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "rigid-transform",
        "declared-attachment",
        "view-dependency"
      ]
    },
    "validUntil": {
      "type": "string",
      "format": "date-time"
    },
    "evidenceCids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cidv1-sha256-[a-f0-9]{64}$"
      },
      "minItems": 1
    },
    "onInvalidation": {
      "enum": [
        "request-refresh",
        "show-unknown",
        "use-explicit-state"
      ]
    }
  },
  "required": [
    "ruleId",
    "inputs",
    "output",
    "operation",
    "validUntil",
    "evidenceCids",
    "onInvalidation"
  ],
  "additionalProperties": false
}
