{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:indranet:candidate:schema:world-package:0.5.0",
  "title": "IndraNet candidate world package",
  "$comment": "Candidate v0.5.0; Rosetta Core semantics retained; no assigned ROCK identifier. Source-of-truth: pack.json.",
  "type": "object",
  "properties": {
    "requiredAssets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^cidv1-sha256-[a-f0-9]{64}$"
      },
      "minItems": 1
    },
    "decoderProfile": {
      "type": "string",
      "minLength": 1
    },
    "purposes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "frame": {
      "type": "string",
      "minLength": 1
    },
    "knownAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "requiredAssets",
    "decoderProfile",
    "purposes",
    "frame",
    "knownAt"
  ],
  "additionalProperties": false
}
