{
  "openapi": "3.1.0",
  "info": {
    "title": "IndraNet local reference inspector",
    "version": "0.4.0",
    "description": "Implemented read-only synthetic scenario API. Not a production ingest or actuation service."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Local JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios": {
      "get": {
        "operationId": "listScenarios",
        "responses": {
          "200": {
            "description": "Local JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios/{name}": {
      "get": {
        "operationId": "readScenario",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "performance",
                "xr",
                "warehouse",
                "public-space",
                "executable-worlds",
                "generative-reality"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Local JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Unknown or not generated"
          }
        }
      }
    }
  }
}
